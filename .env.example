# RAG Knowledge Chatbot - Environment Variables Example
#
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env file to version control (use .env.example instead)
#
# Created: 2026-08-14

# ==============================================================================
# REQUIRED - Anthropic Claude API
# Get your key at: https://console.anthropic.com/
# ==============================================================================
ANTHROPIC_API_KEY=sk-ant-your-actual-key-here

# ==============================================================================
# REQUIRED - Pinecone Vector Database
# Get your key at: https://www.pinecone.io/
# Create index named: hr-policy-kb
# ==============================================================================
PINECONE_API_KEY=pcn-your-actual-key-here
PINECONE_REGION=us-east-1
PINECONE_INDEX_NAME=hr-policy-kb

# ==============================================================================
# REQUIRED - Together AI (Llama Embeddings)
# Get your key at: https://www.together.ai/
# Model: meta-llama-3-8b-instruct
# ==============================================================================
TOGETHER_API_KEY=your-actual-key-here

# ==============================================================================
# OPTIONAL - OpenAI (if using OpenAI embeddings instead of Llama)
# Get your key at: https://platform.openai.com/
# Model: text-embedding-3-large
# ==============================================================================
OPENAI_API_KEY=sk-your-actual-key-here

# ==============================================================================
# OPTIONAL - PostgreSQL Database Configuration
# If not set, system uses in-memory SQLite (dev only)
# Format: postgresql://username:password@host:port/database
# ==============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/rag_chatbot

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Embedding Configuration
EMBEDDING_MODEL=llama
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=20

# LLM Configuration
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# Vector Search Configuration
TOP_K_RESULTS=5
MIN_RELEVANCE_SCORE=0.7

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/chatbot.log

# ==============================================================================
# SECURITY & COMPLIANCE
# ==============================================================================

# Data Retention (days)
MESSAGE_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# Rate Limiting
RATE_LIMIT_QUERIES_PER_MINUTE=60
RATE_LIMIT_QUERIES_PER_DAY=1000

# Enable HTTPS
ENABLE_HTTPS=true
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# ==============================================================================
# DEPLOYMENT ENVIRONMENT
# ==============================================================================

# Environment type: development, staging, production
ENVIRONMENT=development

# For development/testing only - DO NOT use in production
USE_MOCK_API=false

# ==============================================================================
# NOTES
# ==============================================================================
#
# 1. SECURITY: Never commit .env file to git
#    - Use .gitignore: echo ".env" >> .gitignore
#
# 2. API KEYS: Keep your keys secure
#    - Don't share API keys with anyone
#    - Rotate keys regularly
#    - Use IAM roles when possible
#
# 3. DATABASE: PostgreSQL is optional for MVP
#    - Development: SQLite (default)
#    - Production: PostgreSQL + backup strategy
#
# 4. COST TRACKING: Monitor usage
#    - Claude: $3 per 1M input tokens, $15 per 1M output tokens
#    - Llama/Together: $0.10 per 1M tokens
#    - Pinecone: Free tier covers most use cases
#
# 5. TESTING: Use these example values to test setup:
#    python -c "import os; print(os.getenv('ANTHROPIC_API_KEY'))"
#
